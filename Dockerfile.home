# syntax=docker/dockerfile:1

# The build stage runs on the build host's platform: the production dependencies are pure
# JavaScript, so the resulting node_modules works on every target platform.
FROM --platform=$BUILDPLATFORM node:26.13.0-trixie-slim@sha256:e4db4c914bf8ad241bd24804fc25d272d89bad97e68cdc8a1414862790a02c39 AS build
WORKDIR /src/home
COPY home/package.json home/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --no-fund
COPY home/build.mjs home/tsconfig.json ./
COPY home/src ./src
RUN npm run build \
 && npm prune --omit=dev --no-audit --no-fund \
 && if find node_modules \( -name '*.node' -o -name binding.gyp \) | grep -q .; then \
      echo "native modules in production dependencies; build per platform" >&2; exit 1; \
    fi

FROM gcr.io/distroless/nodejs26-debian13:nonroot@sha256:9b945e92c1b5463a4b75f11e8417515e4bea7355f6adfd79ec220fbbe905dda8
WORKDIR /app
COPY --from=build /src/home/package.json ./
COPY --from=build /src/home/node_modules ./node_modules
COPY --from=build /src/home/dist ./dist
ENV NODE_ENV=production
USER 65532:65532
EXPOSE 8081 9090 51830 51831
CMD ["--enable-source-maps", "dist/main.js"]
